# ==========================================
# Spark Hub AI - Environment Variables
# ==========================================

# Server & Database
PORT=5000
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/support_platform
SESSION_SECRET=replace-with-a-long-random-secret
JWT_SECRET=replace-with-a-long-random-secret

# AI Settings (Text Chat - Groq / Ollama / OpenAI)
GROQ_API_KEY=
OPENAI_API_KEY=your_openai_api_key_here_for_realtime_voice

# Meta WhatsApp / Messenger / Instagram
META_APP_ID=
META_APP_SECRET=
META_VERIFY_TOKEN=

# Telephony & Voice Gateway (Provider Agnostic)
# Options: 'mock' (local simulator), 'generic_sip' (SIP Trunk / FreeSWITCH / Asterisk / Telecom Trunks)
TELEPHONY_PROVIDER=mock
TELEPHONY_SIP_GATEWAY_URL=http://localhost:8080
TELEPHONY_WEBHOOK_SECRET=your_telephony_webhook_secret_for_signature_verification
